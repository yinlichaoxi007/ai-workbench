{
  "version": 1,
  "tools": [
    {
      "id": "qoder-cn",
      "name": "Qoder CN",
      "configRoot": "~/.qoder-cn",
      "entry": {
        "path": "~/.qoder-cn/AGENTS.md",
        "alternatives": [],
        "format": "markdown",
        "strategy": "block-append"
      },
      "skillsDir": "~/.qoder-cn/skills",
      "skillsStatus": "documented",
      "status": "documented",
      "notes": "用户级 AGENTS.md；配置根存在；skills 目录当前不存在；加载需部署后新会话实测",
      "versionProbe": {
        "label": "Qoder 应用状态",
        "paths": [
          "{configRoot}/.qoder-app-status.json"
        ],
        "field": "version"
      },
      "enabled": true
    },
    {
      "id": "trae-cn",
      "name": "Trae CN",
      "configRoot": "~/.trae-cn",
      "entry": {
        "path": "~/.trae-cn/user_rules/00-ai-workbench.md",
        "alternatives": [],
        "format": "markdown",
        "strategy": "separate-file"
      },
      "skillsDir": "~/.trae-cn/skills",
      "skillsStatus": "unverified",
      "status": "documented",
      "notes": "全局规则目录已实测；新增独立文件，不碰现有 user_rules。设置里的“导入 AGENTS.md”只导入工作区根目录的 AGENTS.md，不是用户级入口；技能目录待实测",
      "versionProbe": {
        "label": "Trae 安装目录 product.json",
        "paths": [
          "%ProgramFiles%/Trae CN/resources/app/product.json",
          "%LOCALAPPDATA%/Programs/Trae CN/resources/app/product.json",
          "%AIWB_TRAE_CN_HOME%/resources/app/product.json"
        ],
        "field": "appVersion",
        "detailField": "tronBuildVersion"
      },
      "enabled": true
    },
    {
      "id": "codebuddy",
      "name": "CodeBuddy CN",
      "configRoot": "~/.codebuddy",
      "entry": {
        "path": "~/.codebuddy/rules/00-ai-workbench.mdc",
        "alternatives": [],
        "format": "mdc",
        "strategy": "separate-file",
        "frontmatterTemplate": "content/templates/codebuddy-frontmatter.md"
      },
      "skillsDir": "~/.codebuddy/skills",
      "skillsStatus": "unverified",
      "status": "documented",
      "notes": "规则目录已实测；新增独立 .mdc 文件；技能目录待实测",
      "versionProbe": {
        "label": "CodeBuddy 安装目录 product.json",
        "paths": [
          "%ProgramFiles%/CodeBuddy CN/resources/app/product.json",
          "%LOCALAPPDATA%/Programs/CodeBuddy CN/resources/app/product.json",
          "%AIWB_CODEBUDDY_HOME%/resources/app/product.json"
        ],
        "field": "version",
        "detailField": "genieVersion"
      },
      "enabled": true
    },
    {
      "id": "qwenwork-cn",
      "name": "QwenWork CN",
      "configRoot": "~/.qwenworkcn",
      "entry": {
        "path": "~/.qwenworkcn/awareness/main/AGENTS.md",
        "alternatives": [],
        "format": "markdown",
        "strategy": "block-append"
      },
      "skillsDir": "~/.qwenworkcn/skills",
      "skillsStatus": "verified",
      "status": "documented",
      "notes": "用户级入口是应用启动时加载的 awareness/main/AGENTS.md（包内路径与模板初始化均确认）；配置根下的 AGENTS.md/rules.md 不自动加载；技能目录已实测；写入后需新会话抽检",
      "versionProbe": {
        "label": "QwenWork 应用状态",
        "paths": [
          "{configRoot}/.status.json"
        ],
        "field": "version"
      },
      "enabled": true
    },
    {
      "id": "workbuddy",
      "name": "WorkBuddy",
      "configRoot": "~/.workbuddy",
      "entry": {
        "path": "~/.workbuddy/MEMORY.md",
        "alternatives": [],
        "accountDir": {
          "snapshot": "storage/skeleton/account-snapshot.json",
          "path": "user-{uid}-{scope}/MEMORY.md"
        },
        "format": "markdown",
        "strategy": "memory-block",
        "markers": {
          "begin": "<!-- USER-GLOBAL-RULES:BEGIN -->",
          "end": "<!-- USER-GLOBAL-RULES:END -->"
        },
        "placement": "top",
        "budget": {
          "injectLimit": 4000,
          "targetLimit": 3400,
          "blockBudget": 600
        },
        "splitFile": "memory/ai-workbench-global-rules.md"
      },
      "skillsDir": "~/.workbuddy/skills",
      "skillsStatus": "verified",
      "status": "documented",
      "notes": "用户级实际注入账号目录 user-<uid>-<企业或个人>/MEMORY.md，按 storage/skeleton/account-snapshot.json 动态解析；快照缺失、非法或超过 30 天时 WorkBuddy 视为未绑定，回落到设备根 MEMORY.md；部署写入 USER-GLOBAL-RULES 区块，内容超过预算时只留钩子，正文放 memory/ai-workbench-global-rules.md；写入保持无 BOM 与原有换行；需新会话问“当前生效的自定义指令有哪些”实测",
      "versionProbe": {
        "label": "WorkBuddy 安装清单",
        "paths": [
          "%ProgramFiles%/WorkBuddy/resources/install-manifest.json",
          "%LOCALAPPDATA%/Programs/WorkBuddy/resources/install-manifest.json",
          "%AIWB_WORKBUDDY_HOME%/resources/install-manifest.json"
        ],
        "field": "appVersion"
      },
      "enabled": true
    },
    {
      "id": "claude-code",
      "name": "Claude Code",
      "configRoot": "~/.claude",
      "entry": {
        "path": "~/.claude/CLAUDE.md",
        "alternatives": [
          "~/.claude/AGENTS.md"
        ],
        "format": "markdown",
        "strategy": "block-append"
      },
      "skillsDir": "~/.claude/skills",
      "skillsStatus": "documented",
      "status": "documented",
      "notes": "本机未安装；路径按官方文档预留，安装后实测",
      "enabled": false
    },
    {
      "id": "codex",
      "name": "Codex CLI",
      "configRoot": "~/.codex",
      "entry": {
        "path": "~/.codex/AGENTS.md",
        "alternatives": [],
        "format": "markdown",
        "strategy": "block-append"
      },
      "skillsDir": "~/.codex/skills",
      "skillsStatus": "documented",
      "status": "documented",
      "notes": "本机未安装；路径按官方文档预留，安装后实测",
      "enabled": false
    }
  ]
}
